# Pick a PATH, not a raw provider string. sheetflow resolves the model behind it.
LLM_PROFILE=aws            # aws | openai | anthropic | groq | deepseek | local

# aws
AWS_REGION=eu-north-1
# (Bedrock uses the ambient AWS credentials / IAM — no key here)

# openai | anthropic | groq | deepseek
LLM_API_KEY=

# local (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# Where the user's workbook lives. Drafts go to AI_Draft / AI_Review columns in this file.
# For a demo run: Copy-Item test/inventory.xlsx orders.xlsx
# (Pointing this at test/inventory.xlsx edits the test fixture — don't.)
WORKBOOK_PATH=./orders.xlsx

# Driver (npm run inbox). The sheet is re-read every POLL; after TIMEOUT undecided rows are
# recorded as pending and the run resumes anyway.
SHEETFLOW_POLL_MS=2000
SHEETFLOW_REVIEW_TIMEOUT_MS=600000

# Read-only IMAP. Leave IMAP_HOST empty to read .eml files from MAIL_DIR instead.
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_LIMIT=10

# Fallback mailbox: a folder of .eml files (no credentials, no network).
MAIL_DIR=./test/mail
