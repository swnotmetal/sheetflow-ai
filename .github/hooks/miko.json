{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./tools/miko-hook.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node ./tools/miko-hook.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node ./tools/miko-hook.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node ./tools/miko-hook.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./tools/miko-hook.mjs",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
